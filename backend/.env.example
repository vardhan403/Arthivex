# ==============================================================================
# Arthivex Backend - Local Development Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO SOURCE CONTROL
# Copy this file to .env and supply your local development credentials.
# ==============================================================================

# Server Configuration
PORT=8080

# Database Persistence Configuration (PostgreSQL 15+)
DB_URL=jdbc:postgresql://localhost:5432/finguard
DB_USERNAME=finguard_app
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication Configuration
# JWT_SECRET must be at least 256 bits (32 bytes) of high-entropy cryptographic random characters
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_long!
JWT_EXPIRATION_MINUTES=30
JWT_ISSUER=finguard-auth-service

# Cross-Origin Resource Sharing (CORS) Configuration (Strict Allowlist, No Wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First-Administrator Bootstrap Secret
# Required to execute POST /api/v1/auth/bootstrap-admin.
ADMIN_BOOTSTRAP_SECRET=replace_with_a_high_entropy_secret_for_first_admin_bootstrap

# Redis Distributed Rate Limiting (Optional; gracefully falls back to in-memory sliding window when unconfigured)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

